# Placeholder template only. Do not add real credentials to this file.
# Application API access and supplied event credits are pending.
# If the chosen application needs these, place real values in ignored .env.
# This file is not automatically loaded. NTA fetch supports --env-file .env;
# it reads only NTA_API_KEY and never evaluates shell commands.
OPENAI_API_KEY=
OPENAI_MODEL=

# NTA developer-portal subscription key (sent as x-api-key, backend only).
# Obtain your own subscription at https://developer.nationaltransport.ie/.
NTA_API_KEY=
