# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI: used only for interpreting preferences and writing bounded
# explanation text. Routing and scoring stay deterministic, non-AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# MongoDB: single datastore for the OSM graph (nodes/edges with 2dsphere
# geo indexes), per-edge scores, and coverage flags.
# Use mongodb://localhost:27017 for the local docker-compose mongo service,
# or an Atlas mongodb+srv:// URI.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ireland_after_dark

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Frontend build arg (docker compose only; browser-exposed, no secrets here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
